@startuml
!include _dfd-style.iuml

title DFD Level 2 - Process 1.0 Manage Donors

rectangle "Volunteer /\nBlood Bank Staff" as Staff

usecase "1.1\nValidate\nDetails" as P11
usecase "1.2\nCheck Duplicate\nMobile" as P12
usecase "1.3\nSave New\nDonor" as P13
usecase "1.4\nUpdate\nDonor" as P14
usecase "1.5\nDelete\nDonor" as P15

database "D1  Donors" as D1

Staff --> P11 : donor details\n(register or edit)
P11 --> Staff : validation errors
P11 --> P12 : valid details
D1 --> P12 : donor with\nsame mobile
P12 --> Staff : mobile already used
P12 --> P13 : new donor details
P12 --> P14 : edited details
P13 --> D1 : new donor row
P14 --> D1 : updated donor row
Staff --> P15 : confirmed delete request
P15 --> D1 : remove donor row
P13 --> Staff : registered message
P14 --> Staff : details updated message
P15 --> Staff : removed message
@enduml
